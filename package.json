{
  "name": "editableimage-mcp",
  "version": "0.1.0",
  "description": "EditableImage MCP: build structured diagrams and export editable Draw.io nodes and connectors.",
  "type": "module",
  "license": "MIT",
  "author": "j-river",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "editableimage-mcp": "src/cli.js"
  },
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "src/",
    "vendor/",
    "examples/",
    "docs/",
    "server.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j-river/editableimage-mcp.git"
  },
  "homepage": "https://editableimage.com/",
  "bugs": {
    "url": "https://github.com/j-river/editableimage-mcp/issues"
  },
  "mcpName": "io.github.j-river/editableimage",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "editableimage",
    "scene-to-drawio"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/server.js && node --check src/cli.js && npm test",
    "audit:public": "node scripts/audit-public.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
